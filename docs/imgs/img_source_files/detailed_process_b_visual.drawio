        <mxCell id="_4e8fVjvvUdrHk3SvOK6-18" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Process B&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 12px; font-weight: normal;&quot;&gt;Candidate Generation&lt;/span&gt;&lt;/h1&gt;&lt;div&gt;&lt;ol&gt;&lt;li&gt;Load snapshot onto online buffer&lt;/li&gt;&lt;li&gt;Perform beam checks&lt;/li&gt;&lt;li&gt;Generate BPM candidates based on anomaly score&lt;/li&gt;&lt;li&gt;Generate RF candidates using slow/fast trigger&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="566" y="600" width="280" height="180" as="geometry" />
        </mxCell>
        <mxCell id="_4e8fVjvvUdrHk3SvOK6-19" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Beam Checks&lt;br&gt;&lt;/h1&gt;&lt;div&gt;1. Does&amp;nbsp; the beam have standard charge?&lt;/div&gt;&lt;div&gt;2. Is the beam stopper being used?&lt;/div&gt;&lt;div&gt;3. Is the beam rate 120Hz?&lt;/div&gt;&lt;div&gt;4. Is the entire beam being delivered to the hard x-ray line?&lt;br&gt;&lt;/div&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="545" y="981" width="200" height="140" as="geometry" />
        </mxCell>
        <mxCell id="_4e8fVjvvUdrHk3SvOK6-20" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;BPM Candidates&lt;/h1&gt;&lt;p&gt;Compute MAD-based anomaly scores from BPM signals, aggregate across signals and time, and flag candidate if score ≥ threshold.&lt;br&gt;&lt;br&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=default;" vertex="1" parent="1">
          <mxGeometry x="200" y="1201" width="205.5" height="120" as="geometry" />
