        <mxCell id="_4e8fVjvvUdrHk3SvOK6-21" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;RF Candidates&lt;/h1&gt;&lt;p&gt;Search earlier window for first significant deviation.&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Capture surrounding data (~4.3s) for full anomaly context.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Identify RF stations with largest phase deviations&lt;/span&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=default;" vertex="1" parent="1">
